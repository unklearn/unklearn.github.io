{
  "name": "scout-picnic",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build && vite preview --host 127.0.0.1 --port 4333",
    "dev": "vite --host 127.0.0.1 --port 4333",
    "build": "tsc --noEmit && node --import tsx authoring/check.ts && vite build && node --import tsx scripts/prerender.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4333",
    "test": "node --import tsx --test runtime/*.test.ts",
    "record": "node --import tsx scripts/record.ts",
    "verify:live": "node --env-file-if-exists=.env --import tsx scripts/live.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
